# Supabase Postgres: Project > Connect > Transaction pooler (port 6543), with your database password.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Random string, at least 32 chars: openssl rand -base64 32. Signs the login cookie and hashes reset codes.
AUTH_SECRET=

# The public URL of the app, e.g. https://skola.vercel.app. Token audiences are built from it,
# so set it in production. Leave unset locally (http://localhost:3000 is used).
APP_URL=

# "true" (default): anyone can create an account. "false": only the first account.
ALLOW_SIGNUP=true

# Cloudflare R2 picture storage (all four, or pictures stay inside their notes). Create a private
# bucket, an R2 API token with Object Read & Write for that bucket, and add the CORS rule from
# docs/dev-guide.md so browsers can upload and download.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Comma-separated emails allowed to edit the shared default agent skills (at /skills/edit and over
# MCP with scope "default"). Unset means nobody. Every user can always edit their own skills.
SKILL_ADMINS=

# Password-reset emails go through Resend (resend.com). Without a key, dev prints the code in the
# server log and production refuses to send. EMAIL_FROM must be a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Skola <noreply@your-domain.com>
