# Postgres connection string. On Vercel, the Neon integration sets DATABASE_URL for you.
# Use the pooled connection string (host contains "-pooler").
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Random string, at least 32 chars: openssl rand -base64 32. Signs the login cookie and hashes reset codes.
AUTH_SECRET=

# The public URL of the app, e.g. https://skola.vercel.app. Token audiences are built from it,
# so set it in production. Leave unset locally (http://localhost:3000 is used).
APP_URL=

# "true" (default): anyone can create an account. "false": only the first account.
ALLOW_SIGNUP=true

# Password-reset emails go through Resend (resend.com). Without a key, dev prints the code in the
# server log and production refuses to send. EMAIL_FROM must be a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Skola <noreply@your-domain.com>
