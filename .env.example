# Postgres connection string. On Vercel, the Neon integration sets DATABASE_URL for you.
# Use the pooled connection string (host contains "-pooler").
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Random string, at least 32 chars: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The public URL of the app, e.g. https://skola.vercel.app (http://localhost:3000 locally).
BETTER_AUTH_URL=http://localhost:3000

# "true" (default): anyone can create an account. "false": only the first account.
ALLOW_SIGNUP=true
